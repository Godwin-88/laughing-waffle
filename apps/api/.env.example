# Takwimu LMS — API environment. Copy to `apps/api/.env`.
DATABASE_URL=postgres://takwimu:takwimu_dev@localhost:5432/takwimu_lms
REDIS_URL=redis://localhost:6379

API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

JWT_SECRET=dev-only-secret-replace-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false

SMTP_URL=
SMTP_FROM=Takwimu Data School <no-reply@takwimu.school>

STORAGE_DRIVER=auto
TRANSCODE_WORKER=on
API_MAX_UPLOAD_BYTES=10000000000
B2_ENDPOINT=
B2_BUCKET_COURSE_ASSETS=lms-course-assets
B2_BUCKET_USER_UPLOADS=lms-user-uploads
B2_BUCKET_PUBLIC=lms-public
B2_KEY_ID=
B2_APP_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=