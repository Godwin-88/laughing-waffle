# ─────────────────────────────────────────────────────────────
# Takwimu LMS — environment template
# Copy to `.env` at the repo root (used by docker compose) and to
# `apps/api/.env` (used by the API). `apps/web` reads NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────

# Postgres / Redis (docker compose)
POSTGRES_USER=takwimu
POSTGRES_PASSWORD=takwimu_dev
POSTGRES_DB=takwimu_lms

DATABASE_URL=postgres://takwimu:takwimu_dev@localhost:5432/takwimu_lms
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=dev-only-secret-replace-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false

# Mail (empty SMTP_URL → verification links are printed to the API console)
SMTP_URL=
SMTP_FROM=Takwimu Data School <no-reply@takwimu.school>

# Storage (auto → B2 when B2_* is set, otherwise local disk under ./data/storage)
STORAGE_DRIVER=auto
B2_ENDPOINT=
B2_BUCKET_COURSE_ASSETS=
B2_BUCKET_USER_UPLOADS=
B2_BUCKET_PUBLIC=
B2_KEY_ID=
B2_APP_KEY=

# SSO (optional until configured; buttons degrade gracefully with a clear message)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=